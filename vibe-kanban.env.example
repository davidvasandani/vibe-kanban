# Vibe Kanban — production environment (example)
#
# Copy to a real path your service manager can read, e.g.:
#   sudo install -m 600 vibe-kanban.env.example /etc/vibe-kanban.env
# then edit the values below. Referenced by vibe-kanban.service.example via
# `EnvironmentFile=`.
#
# Why this file exists: the server binary picks its port from BACKEND_PORT
# (then PORT), and falls back to port 0 — an OS-assigned *ephemeral* port that
# changes on every restart (crates/server/src/main.rs). A moving port makes the
# long-lived MCP subprocess point at a dead backend after a restart. Pinning the
# values here makes the port static and MCP resolution deterministic.

# --- Server: make the listening port static -----------------------------------
# The main API/UI port. Keep it on loopback and put a reverse proxy in front for
# TLS / a stable public endpoint (see Caddyfile.example, which upstreams to
# 127.0.0.1:3000). Change 3000 if it collides with something else on the host.
HOST=127.0.0.1
BACKEND_PORT=3000

# The preview proxy also defaults to port 0 (ephemeral). Pin it too so it is
# stable across restarts.
PREVIEW_PROXY_PORT=3002

# --- MCP: pin the backend URL -------------------------------------------------
# The MCP resolves its backend in this priority order:
#   VIBE_BACKEND_URL  →  MCP_HOST/MCP_PORT  →  HOST/BACKEND_PORT/PORT  →  port file
# Setting VIBE_BACKEND_URL here (and having the server inherit it) means the MCP
# never touches the port file at all. Coding agents launched by the server
# inherit this environment, so their MCP subprocess resolves deterministically
# too — this is the durable form of the "pin the backend URL" fix in
# crates/mcp/AGENTS.md, and it survives a Settings-UI "Save" (which strips the
# `env` block from the MCP config entry).
#
# Must match HOST:BACKEND_PORT above.
VIBE_BACKEND_URL=http://127.0.0.1:3000

# --- Optional -----------------------------------------------------------------
# Log verbosity for the server crates (default: info).
# RUST_LOG=info
